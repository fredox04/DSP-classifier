        <mxCell id="7YCzna3ruAnbJmfJVBO6-7" parent="1" style="text;whiteSpace=wrap;html=1;align=left;" value="&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;color: rgb(34, 34, 34); font-size: 18px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;- 128 active EEG channels&lt;br&gt;- 8 external active EOG/EMG channels&lt;br&gt;- 24 bits &lt;/span&gt;&lt;span style=&quot;color: rgb(34, 34, 34); font-size: 18px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;resolution&lt;br&gt;- sampling rate of 1024 Hz&lt;/span&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="115" width="550" x="20" y="568" as="geometry" />
        </mxCell>
        <mxCell id="7YCzna3ruAnbJmfJVBO6-17" edge="1" parent="1" source="7YCzna3ruAnbJmfJVBO6-15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;align=center;" target="7YCzna3ruAnbJmfJVBO6-19">
