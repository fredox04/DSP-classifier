          <mxGeometry height="393" width="352" x="1140.5" y="111" as="geometry" />
        </mxCell>
        <mxCell id="7YCzna3ruAnbJmfJVBO6-8" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;imageAspect=0;image=data:image/png,;imageBackground=none;aspect=fixed;align=center;" value="" vertex="1">
          <mxGeometry height="354" width="297" x="1168" y="130.5" as="geometry" />
        </mxCell>
        <mxCell id="7YCzna3ruAnbJmfJVBO6-29" edge="1" parent="1" source="7YCzna3ruAnbJmfJVBO6-19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;align=center;" target="7YCzna3ruAnbJmfJVBO6-21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7YCzna3ruAnbJmfJVBO6-19" parent="1" style="rounded=1;verticalAlign=top;align=center;html=1;whiteSpace=wrap;" value="&lt;b&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;Re-reference&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(34, 34, 34); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen-Sans, Ubuntu, Cantarell, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; background-color: rgb(255, 255, 255);&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;Averaging both EXG1 and EXG2, and then subtracting the virtual channel from each one of the rest of the acquired channels.&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="113" width="470.5" x="1081.25" y="559" as="geometry" />
        </mxCell>
        <mxCell id="7YCzna3ruAnbJmfJVBO6-33" edge="1" parent="1" source="7YCzna3ruAnbJmfJVBO6-21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="7YCzna3ruAnbJmfJVBO6-31">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7YCzna3ruAnbJmfJVBO6-21" parent="1" style="rounded=1;whiteSpace=wrap;align=center;fontStyle=1;fontSize=16;" value="Digital filtering&#xa;&#xa;The lower and upper bounds were set to 0.5 and 100 Hz, respectively.&#xa;&#xa;A Notch filter in 50 Hz was also applied." vertex="1">
          <mxGeometry height="151" width="485" x="1074" y="726" as="geometry" />
        </mxCell>
        <mxCell id="7YCzna3ruAnbJmfJVBO6-36" edge="1" parent="1" source="7YCzna3ruAnbJmfJVBO6-31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="7YCzna3ruAnbJmfJVBO6-35">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7YCzna3ruAnbJmfJVBO6-31" parent="1" style="rounded=1;whiteSpace=wrap;fontStyle=1;fontSize=16;" value="Epoching and decimation&#xa;&#xa;The data were decimated four times, obtaining a final sampling rate of 256 Hz. &#xa;&#xa;The continuous recorded data were epoched, keeping only the 4.5 s length signals corresponding to the time window between the beginning of the concentration interval and the end of the relaxation interval. &#xa;&#xa;The matrices of dimension [channels × samples] corresponding to each trial, were stacked in a final tensor of size [trials × channels × samples]." vertex="1">
          <mxGeometry height="250" width="704" x="964.5" y="948" as="geometry" />
        </mxCell>
        <mxCell id="7YCzna3ruAnbJmfJVBO6-34" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="299" width="719" x="1692" y="912" as="geometry" />
        </mxCell>
        <mxCell id="7YCzna3ruAnbJmfJVBO6-42" edge="1" parent="1" source="7YCzna3ruAnbJmfJVBO6-35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="7YCzna3ruAnbJmfJVBO6-41">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7YCzna3ruAnbJmfJVBO6-35" parent="1" style="rounded=1;whiteSpace=wrap;fontSize=16;fontStyle=1;align=center;" value="Independent components analysis&#xa;&#xa;ICA processing was performed only on the EEG channels, using the MNE implementation of the infomax ICA. No Principal Component Analysis (PCA) was applied and 128 sources were captured. &#xa;&#xa;Correlation with the EXG channels was used to determine the sources related to blink, gaze and mouth movement, which were neglected in the process of reconstructing the EEG signals, for obtaining the final dataset." vertex="1">
          <mxGeometry height="202" width="760" x="936.5" y="1268" as="geometry" />
        </mxCell>
        <mxCell id="7YCzna3ruAnbJmfJVBO6-41" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="677" width="324" x="1154.5" y="1551" as="geometry" />
        </mxCell>
        <mxCell id="7YCzna3ruAnbJmfJVBO6-37" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="644" width="257" x="1193.996666666667" y="1568.0033333333336" as="geometry" />
        </mxCell>
        <UserObject label="&lt;h3 class=&quot;c-article__sub-heading&quot; id=&quot;Sec21&quot; style=&quot;text-align: center; letter-spacing: -0.0117156rem; font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen-Sans, Ubuntu, Cantarell, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; line-height: 1.24; box-sizing: inherit; color: rgb(34, 34, 34); margin: 24px 0px 8px; background-color: rgb(255, 255, 255);&quot;&gt;&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(18, 18, 18)); color: light-dark(rgb(34, 34, 34), rgb(208, 208, 208)); letter-spacing: -0.0117156rem;&quot;&gt;Electroencephalography data&lt;/span&gt;&lt;/h3&gt;&lt;div&gt;&lt;div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;div&gt;&lt;font&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;The file &lt;b&gt;*_eeg-epo.fif&lt;/b&gt; contains the epoched EEG channels for each participant and session during the trial after processing as described above. The dimension of the corresponding tensor data is [trials x 128 x 1154]&lt;/font&gt;&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" link="&lt;span style=&quot;color: rgb(34, 34, 34); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen-Sans, Ubuntu, Cantarell, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-size: 18px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;Each EEG data file, stored in.fif format, contains the acquired data for each participant and session, after processing as described above&lt;/span&gt;" id="7YCzna3ruAnbJmfJVBO6-43">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;fontSize=16;" vertex="1">
            <mxGeometry height="169" width="624" x="1496" y="1568" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="7YCzna3ruAnbJmfJVBO6-45" edge="1" parent="1" source="7YCzna3ruAnbJmfJVBO6-43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="7YCzna3ruAnbJmfJVBO6-43">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7YCzna3ruAnbJmfJVBO6-46" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontSize=16;" value="&lt;h3 class=&quot;c-article__sub-heading&quot; id=&quot;Sec22&quot; style=&quot;letter-spacing: -0.0117156rem; font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen-Sans, Ubuntu, Cantarell, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; line-height: 1.24; box-sizing: inherit; color: rgb(34, 34, 34); margin: 24px 0px 8px; background-color: rgb(255, 255, 255);&quot;&gt;&lt;font&gt;External electrodes data&lt;/font&gt;&lt;/h3&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;text-align: left; white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;text-align: left;&quot;&gt;The file&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;text-align: left;&quot;&gt;*_eeg-epo.fif&lt;/b&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&amp;nbsp;contains the epoched EEG channels for each participant and session during the trial after processing as described above,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); color: rgb(34, 34, 34); text-align: start;&quot;&gt;with the exception of the ICA processing.&lt;/span&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); color: rgb(34, 34, 34); text-align: start;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;text-align: left; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;The dimension of the corresponding tensor data is [trials x 128 x 1154]&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="169" width="618" x="1502" y="1766" as="geometry" />
        </mxCell>
        <mxCell id="7YCzna3ruAnbJmfJVBO6-53" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;fontSize=16;fontColor=default;" value="&lt;h3 class=&quot;c-article__sub-heading&quot; id=&quot;Sec22&quot; style=&quot;letter-spacing: -0.0117156rem; font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen-Sans, Ubuntu, Cantarell, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; line-height: 1.24; box-sizing: inherit; margin: 24px 0px 8px; background-color: rgb(255, 255, 255);&quot;&gt;&lt;font&gt;Event data&lt;/font&gt;&lt;/h3&gt;&lt;div&gt;&lt;br style=&quot;padding: 0px; margin: 0px; text-wrap-mode: nowrap;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;text-wrap-mode: nowrap; background-color: transparent;&quot;&gt;Each event data file (in.dat format) contains a four column matrix&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;where each row corresponds to one trial.&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Column 0 contains the sample number in which the event occurred.&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Column 1 contains the direction of the word:&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;0 = Arriba (up)&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;1 = Abajo (down)&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;2 = Derecha (right)&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;3 = Izquierda (left)&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Column 2 contains the trial condition:&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;0 = Pronounced speech&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;1 = Inner speech&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;2 = Visualized condition&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Column 3 contains the session number:&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;1 = Session 1&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;2 = Session 2&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;3 = Session 3&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="577" width="686" x="1514" y="1947" as="geometry" />
        </mxCell>
        <mxCell id="7YCzna3ruAnbJmfJVBO6-55" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;" value="&lt;h3 class=&quot;c-article__sub-heading&quot; id=&quot;Sec22&quot; style=&quot;letter-spacing: -0.0117156rem; font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen-Sans, Ubuntu, Cantarell, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; line-height: 1.24; box-sizing: inherit; color: rgb(34, 34, 34); margin: 24px 0px 8px; background-color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Baseline&amp;nbsp; electrodes data&lt;/font&gt;&lt;/h3&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Each baseline data file (in.fif format) contains a data tensor of dimension [1 × 136 × 3841]. Here, 1 corresponds to the only recorded baseline in each session, 136 corresponds to the total number of EEG + EXG channels (128 + 8)&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="169" width="583" x="2165" y="1565" as="geometry" />
        </mxCell>
        <mxCell id="7YCzna3ruAnbJmfJVBO6-57" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;" value="&lt;h3 class=&quot;c-article__sub-heading&quot; id=&quot;Sec22&quot; style=&quot;letter-spacing: -0.0117156rem; font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen-Sans, Ubuntu, Cantarell, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; line-height: 1.24; box-sizing: inherit; color: rgb(34, 34, 34); margin: 24px 0px 8px; background-color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Report&lt;/font&gt;&lt;/h3&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(34, 34, 34); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen-Sans, Ubuntu, Cantarell, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-size: 18px; text-align: start; background-color: rgb(255, 255, 255);&quot;&gt;The report file (in.pkl format) contains general information about the participant and the particular results of the session processing&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="169" width="583" x="2165" y="1755" as="geometry" />
        </mxCell>
        <mxCell id="q71g2fg062Ku1108jk6m-2" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="311" width="271" x="1908.997368421053" y="2180.9989473684213" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
